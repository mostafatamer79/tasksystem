# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/tasksystem?schema=public

# Server
PORT=3101
CORS_ORIGIN=http://localhost:3100,http://127.0.0.1:3100,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=900          # 15 minutes (seconds)
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=604800      # 7 days (seconds)

# Cookies
COOKIE_SECURE=false         # true in production (https)
