{
  "name": "tasksystem",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Task Management System — monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "vercel-build": "npm run build -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "build:api": "npm run build -w apps/api",
    "test:api": "npm run test -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "lint:web": "npm run lint -w apps/web",
    "prepare": "node -e \"if (!process.env.VERCEL) { try { require('child_process').execSync('husky', { stdio: 'inherit' }); } catch (e) {} }\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0"
  }
}
